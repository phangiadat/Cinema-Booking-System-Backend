# Environment variables for Cinema Booking System Backend - Test Environment

# Database
DATABASE_URL=mysql://root:30012006@localhost:3306/cinema_booking_test_db

# Server
PORT=5001
NODE_ENV=test

# JWT Secrets for tests
ACCESS_TOKEN_SECRET=test_access_secret_key_long_and_strong_12345
REFRESH_TOKEN_SECRET=test_refresh_secret_key_long_and_strong_12345

# JWT Expiry
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=4

# API
API_PREFIX=/api/v1
